# Copy to .env and fill in real values before running `docker compose up -d`.
# .env is already gitignored — never commit real secrets.

# --- Images (published privately on Docker Hub, see deploy/README.md) ------
# Client machines need `docker login` with pull access to this namespace
# before `docker compose pull` / `docker compose up -d` will work.
DOCKERHUB_NAMESPACE=change-me-dockerhub-namespace
IMAGE_TAG=latest

# --- MySQL --------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password

MONOKEK_DB_NAME=monokek
MONOKEK_DB_USERNAME=monokek_app
MONOKEK_DB_PASSWORD=change-me-monokek-db-password

PMS_DB_NAME=pms
PMS_DB_USERNAME=pms_app
PMS_DB_PASSWORD=change-me-pms-db-password

IDENTITY_DB_USERNAME=identity_app
IDENTITY_DB_PASSWORD=change-me-identity-db-password

# --- Caddy / TLS ------------------------------------------------------------
# IP ou nom LAN de CE serveur, tel que les postes l'utilisent (entre dans le certificat TLS).
CADDY_HOST=192.168.1.50

# --- monokek-identity -------------------------------------------------------
# Public LAN address this server is reached at, through Caddy — e.g.
# https://192.168.1.50:8443 (the HTTPS port, same value as CADDY_HTTPS_URL). Must be consistent:
# every client validates JWTs' "iss" claim against exactly this value.
IDENTITY_ISSUER=https://CHANGE-ME-SERVER-LAN-ADDRESS:8443
# RSA keypair used to sign tokens — generate once and keep stable across
# redeploys (a new keypair on every deploy invalidates every outstanding
# token). PKCS8/X509 PEM, base64 body only (header/footer lines stripped
# either way), one line each:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt | tee private.pem | \
#     openssl rsa -pubout > public.pem
#   grep -v -- '-----' private.pem | tr -d '\n'   # -> IDENTITY_RSA_PRIVATE_KEY_PEM
#   grep -v -- '-----' public.pem  | tr -d '\n'   # -> IDENTITY_RSA_PUBLIC_KEY_PEM
IDENTITY_RSA_PRIVATE_KEY_PEM=
IDENTITY_RSA_PUBLIC_KEY_PEM=
# OAuth2 client credentials — one per caller, least privilege (replaces the
# single shared JWT_SECRET every service used to trust). See
# monokek-identity's ClientSeeder for exactly what each one is allowed to do.
IDENTITY_POS_CLIENT_SECRET=change-me-pos-client-secret
IDENTITY_MONOKEK_SPRING_CLIENT_SECRET=change-me-monokek-spring-client-secret
IDENTITY_INTERNAL_CLIENT_SECRET=change-me-identity-internal-client-secret

# --- monokek-spring -------------------------------------------------------
# Clé PUBLIQUE RSA du vendeur (vérifie les licences hors ligne ; ne permet pas d'en créer).
# Obtenue une seule fois côté vendeur avec `./generate-license.sh keygen` (dans monokek-spring) ;
# la clé privée correspondante ne doit JAMAIS figurer dans ce fichier ni sur un serveur client.
LICENSE_PUBLIC_KEY=
# Tauri's webview origin is fixed regardless of which LAN machine it runs on
# — no change needed here even though the server itself is reached by IP.
CORS_ALLOWED_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# --- pms-modulith -----------------------------------------------------------
CHANNEL_MANAGER_WEBHOOK_TOKEN=change-me-webhook-secret
PMS_CORS_ALLOWED_ORIGINS=http://localhost:3001,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# --- Object storage (SeaweedFS; MINIO_* names kept for compatibility) -------------------------------------------------------
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key-min-8-chars
MINIO_BUCKET=monokek
# Public path under which Caddy exposes the bucket (/media/<bucket>/<key>).
# Keep it as a PATH, never a host: uploaded-file references are stored without any address and
# each API response is completed with the host the caller used (see MEDIA_BASE_PATH below).
MINIO_PUBLIC_ENDPOINT=/media
# Same path; blank only for a local setup without Caddy (then MINIO_PUBLIC_ENDPOINT must be an
# absolute, client-reachable URL such as http://localhost:9000).
MEDIA_BASE_PATH=/media

# --- Backups ------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400

# SeaweedFS image tag (pin an exact release in production).
# SEAWEEDFS_VERSION=latest
