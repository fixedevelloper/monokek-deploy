# Copy to .env and fill in real values before running `docker compose up -d`.
# .env is already gitignored — never commit real secrets.

# --- Images (published privately on Docker Hub, see deploy/README.md) ------
# Client machines need `docker login` with pull access to this namespace
# before `docker compose pull` / `docker compose up -d` will work.
DOCKERHUB_NAMESPACE=change-me-dockerhub-namespace
IMAGE_TAG=latest

# --- MySQL --------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password

MONOKEK_DB_NAME=monokek
MONOKEK_DB_USERNAME=monokek_app
MONOKEK_DB_PASSWORD=change-me-monokek-db-password

PMS_DB_NAME=pms
PMS_DB_USERNAME=pms_app
PMS_DB_PASSWORD=change-me-pms-db-password

# --- Shared identity (must be identical for both apps: monokek-spring   --
# issues the JWTs, pms-modulith only validates them with this secret)   --
JWT_SECRET=change-me-32-chars-minimum-shared-secret
JWT_TTL_MINUTES=480

# --- monokek-spring -------------------------------------------------------
LICENSE_SIGNING_KEY=change-me-license-signing-key-change-me-32
# Tauri's webview origin is fixed regardless of which LAN machine it runs on
# — no change needed here even though the server itself is reached by IP.
CORS_ALLOWED_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# --- pms-modulith -----------------------------------------------------------
CHANNEL_MANAGER_WEBHOOK_TOKEN=change-me-webhook-secret
PMS_CORS_ALLOWED_ORIGINS=http://localhost:3001,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# --- MinIO ------------------------------------------------------------------
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key-min-8-chars
MINIO_BUCKET=monokek
# LAN address of this server — Tauri clients on other machines fetch
# uploaded files straight from MinIO using this URL. Set to the server's
# LAN IP or hostname, e.g. http://192.168.1.50:9000
MINIO_PUBLIC_ENDPOINT=http://CHANGE-ME-SERVER-LAN-ADDRESS:9000

# --- Backups ------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
